# float-editor 피사체 분리 서버 — CPU 전용 / 멀티아키(amd64·arm64)
# macOS(Apple Silicon 포함)·GPU 없는 리눅스 등 어디서나 동작. 단 CPU라 느림(장당 수 초).
# ⚠️ Docker on macOS는 Mac GPU(Metal)를 쓸 수 없으므로 Mac에선 이 CPU 이미지가 최선.
#    Mac에서 GPU(MPS) 가속을 원하면 도커 대신 네이티브 실행(README 참고).
#
# 멀티아키 빌드·푸시(buildx):
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f cutout-server/Dockerfile.cpu -t dilly97/float-cutout:cpu --push cutout-server
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
# CPU torch (amd64·arm64 휠 제공) — 베이스에 torch가 없으므로 직접 설치
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements.txt

COPY . .

ENV HF_HOME=/app/.hf-cache

EXPOSE 8322
CMD ["sh", "-c", "exec uvicorn server:app --host 0.0.0.0 --port 8322"]
